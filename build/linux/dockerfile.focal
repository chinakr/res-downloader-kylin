# KYLIN-FORK: 低 glibc 基线的 Linux 构建镜像
#
# 为什么要这个文件：上游 build/linux/dockerfile 用 golang:1.25-bookworm（glibc 2.36），
# 产出的二进制要求 GLIBC_2.34，在银河麒麟 V10 SP1 / UOS / Ubuntu 20.04 这类
# glibc 2.31 的基线上直接执行会报
#   /lib/aarch64-linux-gnu/libc.so.6: version `GLIBC_2.34' not found
# （官方 3.1.3 的 linux_arm64 产物在本机实测就是这个报错）。
#
# cgo 链接用的是构建机自己的 crt1.o 与 libc，所以产物门槛取决于构建基线，而不是 Go 版本。
# 这里用 ubuntu:20.04（glibc 2.31，且 libwebkit2gtk-4.0-dev 恰好是 2.38.6，
# 与麒麟已装运行时同版本）编译，实测产物门槛降到 GLIBC_2.17，可在 arm64/x86_64 的
# 老基线系统上原生运行。
#
# 用法（与上游同构，可直接接进 release-linux 的 CI 矩阵）：
#   docker build --platform linux/arm64 -f build/linux/dockerfile.focal -t resd-focal-build .
#   docker run --rm --platform linux/arm64 resd-focal-build
FROM ubuntu:20.04

ARG TARGETARCH=arm64
ARG GO_VERSION=1.25.1
ARG NODE_VERSION=v22.14.0

ENV DEBIAN_FRONTEND=noninteractive \
    GOPROXY=https://goproxy.cn,direct \
    CGO_ENABLED=1

# 最小镜像里没有 ca-certificates，换源必须用 http，否则连 ca-certificates 都装不上
RUN sed -i "s|http://[a-z]*.ubuntu.com/ubuntu-ports|http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g; s|http://[a-z]*.ubuntu.com/ubuntu\b|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g" /etc/apt/sources.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git jq kmod \
      build-essential pkg-config \
      libgtk-3-dev libwebkit2gtk-4.0-dev \
      libfuse-dev libfuse2 fuse file patch \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://golang.google.cn/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tgz \
 && tar -C /usr/local -xzf /tmp/go.tgz && rm -f /tmp/go.tgz \
 && /usr/local/go/bin/go version

RUN curl -fsSL "https://registry.npmmirror.com/-/binary/node/${NODE_VERSION}/node-${NODE_VERSION}-linux-${TARGETARCH}.tar.gz" -o /tmp/node.tgz \
 && mkdir -p /usr/local/node && tar -C /usr/local/node --strip-components=1 -xzf /tmp/node.tgz \
 && rm -f /tmp/node.tgz && ln -sf /usr/local/node/bin/node /usr/local/bin/node \
 && ln -sf /usr/local/node/bin/npm /usr/local/bin/npm && ln -sf /usr/local/node/bin/npx /usr/local/bin/npx \
 && node -v && npm config set registry https://registry.npmmirror.com -g

WORKDIR /src
CMD ["bash"]
